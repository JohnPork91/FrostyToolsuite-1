<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows because FrostySdk (referenced for ILogger) still targets net10.0-windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Frosty.ImGuiKit</RootNamespace>
    <AssemblyName>FrostyImGui</AssemblyName>
    <Platforms>x64</Platforms>
    <Configurations>Developer - Debug;Release - Alpha;Release - Beta;Release - Final</Configurations>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <!-- game icon extraction (Icon.ExtractAssociatedIcon) for the game picker -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only needed for the ILogger interface used by TaskDialog. -->
    <ProjectReference Include="..\FrostySdk\FrostySdk.csproj" />
  </ItemGroup>

</Project>
